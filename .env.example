# Leave these unset and the app runs in demo mode (local, self-simulating).
# Set them to point at a real Supabase project (auth + Postgres + Realtime + Edge).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: self-hosted / staging Edge Functions origin.
EXPO_PUBLIC_EDGE_ORIGIN=

# Optional: centre the fallback viewport somewhere other than Lagos.
EXPO_PUBLIC_DEMO_CENTER_LAT=
EXPO_PUBLIC_DEMO_CENTER_LNG=

# Optional: use react-native-maps (real tiles) on native instead of the
# offline schematic map.
EXPO_PUBLIC_USE_NATIVE_MAPS=

# Local-only, used by tools/*.mjs admin scripts (apply-schema, backfill, verify-server).
# NEVER commit a real value. Project Settings → Database → Connection string (pooled, :6543).
DATABASE_URL=
